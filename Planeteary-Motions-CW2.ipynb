   "outputs": [],
   "source": [
    "G = 6.67348e-11\n",
    "M = 1.989e30\n",
    "R = 149.6e9\n",
    "m = 5.972e24\n",
   
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "id": "3cf857a0",
   "metadata": {},
   "outputs": [],
   "source": [
    "import numpy as np\n",
    "\n",
    "G = 6.67348e-11\n",
    "M = 1.989e30\n",
    "R = 149.6e9\n",
    "m = 5.972e24\n",
    "\n",
    "r0 = np.array([R, 0.0])\n",
    "v0 = np.array([0.0, 29.8e3])\n",
    "\n",
    "r_sun = np.array([0.0, 0.0])\n",
    "v_sun = np.array([0.0, 0.0])\n",
    "\n",
    "masses = np.array([M, m])\n",
    "\n",
    "dt = 3600.0\n",
    "simulation_days = 400\n",
    "n_steps = int(simulation_days * 24 * 3600 / dt)\n",
    "\n",
    "time = np.arange(n_steps + 1) * dt"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 10,
   "id": "8a595359",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Eq.1\n",
    "def acceleration(r_earth):\n",
    "\n",
    "    positions = np.array([r_sun, r_earth])\n",
    "\n",
    "    i = 1  # Earth\n",
    "    force = np.zeros(2)\n",
    "\n",
    "    for j in range(len(masses)):\n",
    "        if j != i:\n",
    "            displacement = positions[j] - positions[i]\n",
    "\n",
    "            force += (\n",
    "                G * masses[i] * masses[j]\n",
    "                * displacement\n",
    "                / np.linalg.norm(displacement)**3\n",
    "            )\n",
    "\n",
    "    return force / masses[i]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 11,
   "id": "e9654f90",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Eq.5 and Eq.6\n",
    "def verlet(r0, v0, dt, n_steps):\n",
    "\n",
    "    positions = np.zeros((n_steps + 1, 2))\n",
    "    velocities = np.zeros((n_steps + 1, 2))\n",
    "\n",
    "    positions[0] = r0\n",
    "    velocities[0] = v0\n",
    "\n",
    "    for k in range(n_steps):\n",
    "\n",
    "        a_k = acceleration(positions[k])\n",
    "\n",
    "        # Equation (5): position update\n",
    "        positions[k + 1] = (\n",
    "            positions[k]\n",
    "            + velocities[k] * dt\n",
    "            + 0.5 * a_k * dt**2\n",
    "        )\n",
    "\n",
    "        a_k1 = acceleration(positions[k + 1])\n",
    "\n",
    "        # Equation (6): velocity update\n",
    "        velocities[k + 1] = (\n",
    "            velocities[k]\n",
    "            + 0.5 * (a_k + a_k1) * dt\n",
    "        )\n",
    "\n",
    "    return positions, velocities"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 15,
   "id": "86783503",
   "metadata": {},
   "outputs": [],
   "source": [
    "positions, velocities = verlet(r0, v0, dt, n_steps)"
   ]
  },
