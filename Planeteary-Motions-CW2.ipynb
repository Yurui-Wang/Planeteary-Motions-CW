   "source": [
    "def energy(r_earth, v_earth):\n",
    "    kinetic = 0\n",
    "    positions = np.array([r_sun, r_earth])\n",
    "    velocities = np.array([v_sun, v_earth])\n",
    "    for i in range(2):\n",
    "        kinetic += 0.5 * masses[i] * np.linalg.norm(velocities[i]) **2\n",
    "    potential = 0\n",
    "    for i in range(2):\n",
    "        for j in range(i):\n",
    "            potential += G * masses[i] * masses[j] / np.linalg.norm(positions[j]-positions[i])\n",
    "    total = kinetic - potential\n",
    "    return kinetic, potential, total"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 57,
   "id": "9bbd8e34",
   "metadata": {},
   "outputs": [],
   "source": [
    "energies = np.array([energy(positions[k], velocities[k]) for k in range(n_steps+1)])"
   ]
  },
